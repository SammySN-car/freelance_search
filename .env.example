DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_OWNER_ID=123456789012345678
DISCORD_CHANNEL_ID=123456789012345678
SERPAPI_API_KEY=replace-with-serpapi-key

# Your details: everything below drives searches, ranking, and judging.
LOCATION=
EXPERIENCE_LEVEL=beginner
# Optional: your GitHub profile. The tool reads your actual code and detects
# your level for you (re-checked every GITHUB_REFRESH_DAYS). Leave empty to
# rely on EXPERIENCE_LEVEL only.
GITHUB_URL=
GITHUB_REFRESH_DAYS=2
PROFILE=Describe yourself here: skills, what you are learning, and what kind of work you want - freelance, internship, or job. Add SKIP: lines for what you never want.

DIGEST_TIME=08:00
DIGEST_TIMEZONE=Asia/Kolkata
DIGEST_SIZE=25
DATABASE_PATH=data/freelance_search.db
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_TIMEOUT_SECONDS=180
MAX_TO_SCORE=50
MIN_SCORE=5.0
SERPAPI_QUERIES=["AI automation freelance","RAG chatbot developer freelance","AI engineer intern remote","AI engineer entry level remote","machine learning internship"]